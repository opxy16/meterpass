{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/next/dist/bin/next",
        "dev",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "dashboard-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/next/dist/bin/next",
        "start",
        "apps/web",
        "-p",
        "3002"
      ],
      "port": 3002
    }
  ]
}